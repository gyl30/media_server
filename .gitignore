!/docs/verification_results/**/*.md
!/docs/verification_results/**/*.py
!/docs/verification_results/**/*.sh
!/docs/verification_results/**/*.patch
!/docs/verification_results/**/*.diff
!/docs/verification_results/**/*.cpp
!/docs/verification_results/**/*.h
!/docs/verification_results/**/*.c

# Dependencies built by deps/build.sh
