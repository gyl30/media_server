+#define POW43_TAB_SIZE (1 << 13)
+
+/* c*cbrtf(c) exactly as the escape path computed it per coefficient */
+static float aac_pow43_tab[POW43_TAB_SIZE];
+
+static av_cold void aac_pow43_tab_init(void)
+{
+    for (int c = 0; c < POW43_TAB_SIZE; c++)
+        aac_pow43_tab[c] = c*cbrtf(c);
+}
+
+av_cold void ff_aac_coder_init_tables(void)
+{
+    static AVOnce init_once = AV_ONCE_INIT;
+    ff_thread_once(&init_once, aac_pow43_tab_init);
+}
